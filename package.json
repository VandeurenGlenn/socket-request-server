{
  "name": "socket-request-server",
  "version": "1.7.4",
  "description": "Simple WebSocket request/response server",
  "type": "module",
  "exports": {
    ".": {
      "import": "./exports/server.js",
      "types": "./exports/types/server.d.ts"
    },
    "./response": {
