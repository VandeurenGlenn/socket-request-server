  "dependencies": {
    "@vandeurenglenn/little-pubsub": "^1.5.2",
    "websocket": "^1.0.35"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/websocket": "^1.0.10",
    "rollup": "^4.62.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
